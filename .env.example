UPSTOX_CLIENT_ID=replace-with-your-upstox-client-id
UPSTOX_CLIENT_SECRET=replace-with-your-upstox-client-secret
UPSTOX_REDIRECT_URI=https://your-app.example/oauth/callback
SESSION_SECRET=replace-with-a-long-random-secret
UPSTOX_TOKEN_ENCRYPTION_KEY=replace-with-output-of-Fernet.generate_key
DATABASE_PATH=./data/upstox.sqlite3
NEWS_FEEDS=[{"name":"Moneycontrol","url":"https://www.moneycontrol.com/rss/marketreports.xml"},{"name":"Investing.com","url":"https://www.investing.com/rss/news_25.rss"}]
# Optional: provide a Firebase service-account file path to enable high-impact news pushes.
GOOGLE_APPLICATION_CREDENTIALS=
MARKET_ALERT_CHANGE_PERCENT=1.0
# Optional exact web origins for hosted Flutter Web deployments, comma-separated.
# Localhost origins (any port) are allowed for local development by default.
CORS_ORIGINS=
